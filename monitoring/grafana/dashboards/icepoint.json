{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "IcePoint Coffee",
  "tags": ["icepoint", "minecraft"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "总请求数",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(icepoint_http_requests_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI 调用/秒",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(rate(icepoint_ai_chat_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "建筑数",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(icepoint_build_total)", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}}
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "内存使用",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "icepoint_go_memstats_alloc_bytes / 1024 / 1024", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "decmbytes", "decimals": 1}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 请求速率 (按端点)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (path) (rate(icepoint_http_requests_total[5m]))", "refId": "A", "legendFormat": "{{path}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 请求延迟 P99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, path) (rate(icepoint_http_request_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p99 {{path}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI 聊天调用",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "rate(icepoint_ai_chat_success_total[5m])", "refId": "A", "legendFormat": "成功"},
        {"expr": "rate(icepoint_ai_chat_failed_total[5m])", "refId": "B", "legendFormat": "失败"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "建筑生成速率",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "rate(icepoint_build_total[5m])", "refId": "A", "legendFormat": "总数"},
        {"expr": "rate(icepoint_build_blocks_total[5m])", "refId": "B", "legendFormat": "方块/秒"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "建筑延迟 (P50/P95/P99)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(icepoint_build_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(icepoint_build_duration_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(icepoint_build_duration_seconds_bucket[5m])))", "refId": "C", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Go Runtime 指标",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "icepoint_go_memstats_alloc_bytes", "refId": "A", "legendFormat": "Alloc"},
        {"expr": "icepoint_go_memstats_sys_bytes", "refId": "B", "legendFormat": "Sys"},
        {"expr": "icepoint_go_goroutines", "refId": "C", "legendFormat": "Goroutines"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SSE 事件流连接数",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {"expr": "icepoint_event_stream_connections", "refId": "A", "legendFormat": "Active"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SSE 消息发送速率",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"expr": "rate(icepoint_event_stream_messages_total[5m])", "refId": "A", "legendFormat": "{{type}}"}
      ]
    }
  ]
}
